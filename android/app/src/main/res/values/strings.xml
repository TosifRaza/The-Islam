    <string name="splash_tagline">Knowledge, preserved and organised</string>
    <string name="onboarding_title_1">A trusted Islamic library</string>
    <string name="onboarding_body_1">Browse curated subjects — Quran and Tafsir, Hadith, Fiqh, Aqeedah and classical works — reviewed through a structured editorial and scholarly workflow.</string>
    <string name="onboarding_title_2">Learn at your pace</string>
    <string name="onboarding_body_2">The Academy brings structured courses and progressive learning. Your reading progress stays in sync across your sessions.</string>
    <string name="onboarding_title_3">Research with integrity</string>
    <string name="onboarding_body_3">AI-assisted research with transparent citations is prepared for this platform — religious answers are always reviewed before publication.</string>
    <string name="onboarding_permissions_title">A note on permissions</string>
    <string name="onboarding_permissions_body">The app currently needs network access only. Features such as prayer times may later request location — you can deny optional permissions and still browse all core content.</string>
    <string name="onboarding_continue">Continue</string>

