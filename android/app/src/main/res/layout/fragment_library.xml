<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Search entry -->
        <LinearLayout
            android:id="@+id/library_search_entry"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:layout_margin="@dimen/space_md"
            android:background="@drawable/bg_search_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:contentDescription="@string/cd_search">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/library_search_hint"
                android:textAppearance="@style/TextAppearance.IKP.BodyMedium"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_lg">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.ikp.dev.app.ui.common.StateView
                            android:id="@+id/library_state"
                            android:layout_width="match_parent"
                            android:layout_height="280dp" />

                        <LinearLayout
                            android:id="@+id/library_sections"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                style="@style/SectionHeader"
                                android:text="@string/library_categories" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_subjects"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/space_md"
                                android:paddingEnd="@dimen/space_md"
                                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                                app:spanCount="2" />

                            <TextView
                                style="@style/SectionHeader"
                                android:text="@string/library_recently_viewed" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_recent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:clipToPadding="false"
                                android:paddingStart="@dimen/space_md"
                                android:paddingEnd="@dimen/space_md"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                            <Button
                                android:id="@+id/btn_browse_all"
                                style="@style/Widget.IKP.Button.Gold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/space_md"
                                android:text="@string/library_all_books" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
