<?xml version="1.0" encoding="utf-8"?>
<!-- Course detail (M5): structure, enrolment and per-lesson completion. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/TouchBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/tv_course_title"
            style="@style/TextAppearance.IKP.HeadlineSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/course_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingBottom="@dimen/space_lg">

                <TextView
                    android:id="@+id/tv_course_meta"
                    style="@style/TextAppearance.IKP.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tv_credentials"
                    style="@style/TextAppearance.IKP.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_xs"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_description"
                    style="@style/TextAppearance.IKP.BodyLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_sm" />

                <Button
                    android:id="@+id/btn_enrol"
                    style="@style/Widget.IKP.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/academy_enrol" />

                <TextView
                    android:id="@+id/tv_progress"
                    style="@style/TextAppearance.IKP.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_sm"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/chapters_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_md" />
            </LinearLayout>
        </ScrollView>

        <com.ikp.dev.app.ui.common.StateView
            android:id="@+id/course_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
