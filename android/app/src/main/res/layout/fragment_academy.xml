<?xml version="1.0" encoding="utf-8"?>
<!-- IKP Academy: Premium Master Islamic Learning Platform -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/academy_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_home_warm"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ================= SECTION A: Premium Master Academy Header ================= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/bg_academy_header_complete"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <!-- Interactive Back Button overlay -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|top"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back" />

            <!-- Interactive Bookmark Shortcut Button overlay -->
            <ImageButton
                android:id="@+id/btn_header_bookmark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_bookmark" />

            <!-- Guest / Member sign-in notice overlay -->
            <TextView
                android:id="@+id/tv_signin_hint"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- Content Container (Padding 16dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <!-- ================= SECTION B: Search Bar ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_search_bar_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="7dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="#7A8880"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/et_academy_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/academy_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#12291F"
                    android:textColorHint="#8A9990"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_clear_search"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_delete"
                    app:tint="#8A9990"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:contentDescription="@string/action_close" />

                <ImageButton
                    android:id="@+id/btn_filter_dialog"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_green_filter_btn"
                    android:src="@drawable/ic_filter_sliders"
                    android:padding="8dp"
                    app:tint="#FFFFFF"
                    android:contentDescription="@string/search_title" />
            </LinearLayout>

            <!-- ================= SECTION C: 4 Standalone Quick Access Cards ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- 1. Courses -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_quick_my_courses"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#DFD7C7"
                    app:cardBackgroundColor="#FAF7F2"
                    app:contentPadding="0dp"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:src="@drawable/ic_card_arch_watermark"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_quick_courses"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/academy_quick_my_courses"
                                android:textColor="#12291F"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:fontFamily="serif" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Downloads -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_quick_downloads"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#DFD7C7"
                    app:cardBackgroundColor="#FAF7F2"
                    app:contentPadding="0dp"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:src="@drawable/ic_card_arch_watermark"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_quick_downloads"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/academy_quick_downloads"
                                android:textColor="#12291F"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:fontFamily="serif" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Certificates -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_quick_certificates"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#DFD7C7"
                    app:cardBackgroundColor="#FAF7F2"
                    app:contentPadding="0dp"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:src="@drawable/ic_card_arch_watermark"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_quick_certificates"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/academy_quick_certificates"
                                android:textColor="#12291F"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:fontFamily="serif" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Progress -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_quick_progress"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#DFD7C7"
                    app:cardBackgroundColor="#FAF7F2"
                    app:contentPadding="0dp"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:src="@drawable/ic_card_arch_watermark"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_quick_progress"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/academy_quick_progress"
                                android:textColor="#12291F"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:fontFamily="serif" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= SECTION D: Explore Categories ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_category_grid_master"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/academy_categories_title"
                    android:textColor="#0D3B2E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />
            </LinearLayout>

            <!-- Horizontal Category Chips with Next Chevron -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_categories"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal" />

                <ImageButton
                    android:id="@+id/btn_category_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/btn_category_next"
                    android:contentDescription="@string/action_next" />
            </LinearLayout>

            <!-- ================= SECTION F: Continue Learning Rail ================= -->
            <LinearLayout
                android:id="@+id/container_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/academy_continue"
                    android:textColor="#0D3B2E"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- ================= SECTION G: Daily Islamic Lesson ================= -->
            <FrameLayout
                android:id="@+id/card_daily_lesson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/bg_daily_deen_full"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />

                <!-- Transparent Clickable Button overlay on the Start Lesson Button -->
                <Button
                    android:id="@+id/btn_start_daily_lesson"
                    android:layout_width="160dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="10dp"
                    android:background="@android:color/transparent"
                    android:text="" />

                <!-- Hidden text views for ViewModel data binding without crashing -->
                <TextView
                    android:id="@+id/tv_daily_title"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="invisible" />
                <TextView
                    android:id="@+id/tv_daily_preview"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="invisible" />
                <TextView
                    android:id="@+id/tv_daily_duration"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- ================= SECTION H: Flashcard Practice Decks ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/academy_flashcards_section"
                    android:textColor="#0D3B2E"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:id="@+id/btn_view_all_flashcards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_view_all"
                    android:textColor="#C9A45A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_flashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <!-- ================= SECTION E: Featured Courses ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/label_courses_section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/academy_featured_title"
                    android:textColor="#0D3B2E"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:id="@+id/tv_active_filter_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#7A8880"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Course Cards List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_courses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />

            <!-- Empty Courses Search Result Hint -->
            <TextView
                android:id="@+id/tv_no_courses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/academy_no_courses_found"
                android:textColor="#7A8880"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- StateView for Network Loading / Error Handling -->
            <com.ikp.dev.app.ui.common.StateView
                android:id="@+id/academy_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
