<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="3dp"
    android:background="@drawable/bg_library_featured_card"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <ImageView
        android:id="@+id/featured_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_shortcut_books"
        android:tint="@color/library_green"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/featured_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="@color/library_ink"
        android:textSize="11sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
