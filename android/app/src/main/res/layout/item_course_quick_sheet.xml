<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:strokeColor="#DFD7C7"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sheet_course_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Al-Quran &amp; Tafsir"
                android:textColor="#0D3B2E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sheet_course_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Lessons • 8 Hours"
                android:textColor="#7A8880"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sheet_course_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:text="Tajweed al-Quran: Master Quranic Recitation &amp; Rules"
            android:textColor="#12291F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sheet_course_instructor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sheikh Ahmad Al-Sayed"
                android:textColor="#5A6D63"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_sheet_open_course"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#0D3B2E"
                android:fontFamily="serif"
                android:paddingHorizontal="14dp"
                android:text="Open Course"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
