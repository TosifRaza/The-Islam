<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/offline_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <include
        android:id="@+id/offline_banner"
        layout="@layout/view_offline_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Custom six-section bottom bar: BottomNavigationView caps at five
         items, and the approved IA has six primary sections. Equal-weight
         touch targets (>=48dp) with selected-state tinting. -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_bar_height"
        android:background="@color/bottom_bar_background"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout style="@style/Widget.IKP.BottomBarItem" android:id="@+id/btn_home"
            android:contentDescription="@string/cd_nav_home">
            <ImageView style="@style/NavIcon" android:id="@+id/icon_home"
                android:src="@drawable/ic_nav_home" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:id="@+id/label_home"
                android:text="@string/nav_home" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.IKP.BottomBarItem" android:id="@+id/btn_library"
            android:contentDescription="@string/cd_nav_library">
            <ImageView style="@style/NavIcon" android:id="@+id/icon_library"
                android:src="@drawable/ic_nav_library" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:id="@+id/label_library"
                android:text="@string/nav_library" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.IKP.BottomBarItem" android:id="@+id/btn_academy"
            android:contentDescription="@string/cd_nav_academy">
            <ImageView style="@style/NavIcon" android:id="@+id/icon_academy"
                android:src="@drawable/ic_nav_academy" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:id="@+id/label_academy"
                android:text="@string/nav_academy" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.IKP.BottomBarItem" android:id="@+id/btn_research"
            android:contentDescription="@string/cd_nav_research">
            <ImageView style="@style/NavIcon" android:id="@+id/icon_research"
                android:src="@drawable/ic_nav_research" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:id="@+id/label_research"
                android:text="@string/nav_research" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.IKP.BottomBarItem" android:id="@+id/btn_assistant"
            android:contentDescription="@string/cd_nav_assistant">
            <ImageView style="@style/NavIcon" android:id="@+id/icon_assistant"
                android:src="@drawable/ic_nav_assistant" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:id="@+id/label_assistant"
                android:text="@string/nav_assistant" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.IKP.BottomBarItem" android:id="@+id/btn_profile"
            android:contentDescription="@string/cd_nav_profile">
            <ImageView style="@style/NavIcon" android:id="@+id/icon_profile"
                android:src="@drawable/ic_nav_profile" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:id="@+id/label_profile"
                android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
