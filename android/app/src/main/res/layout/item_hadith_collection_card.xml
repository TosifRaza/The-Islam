<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_collection_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="3.5dp"
    android:layout_marginBottom="3.5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#ECE6DA"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <!-- 3D Book Cover Graphic on the left -->
        <ImageView
            android:id="@+id/iv_book_cover"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hadith_book_bukhari"
            android:contentDescription="@null"
            android:layout_marginEnd="10dp" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top Row: English Title (left), Arabic Title (middle-right), Bookmark (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_name_en"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sahih al-Bukhari"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_name_ar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صحيح البخاري"
                    android:textColor="#0D3B2E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textDirection="rtl"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btn_bookmark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_bookmark_outline"
                    app:tint="#C5A059"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Bookmark collection" />
            </LinearLayout>

            <!-- Middle Row: Subtitle -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Most Authentic Collection"
                android:textColor="#5A6578"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <!-- Bottom Row: Ahadith count, Books count, Status badge, Chevron -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <!-- Ahadith Count -->
                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_hadith_stats_book"
                    app:tint="#4B5563"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_hadith_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7,563 Ahadith"
                    android:textColor="#374151"
                    android:textSize="10.5sp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="8dp" />

                <!-- Books Count -->
                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_hadith_stats_folder"
                    app:tint="#4B5563"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_book_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="97 Books"
                    android:textColor="#374151"
                    android:textSize="10.5sp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="8dp" />

                <!-- Badges -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- Verified Pill -->
                    <LinearLayout
                        android:id="@+id/badge_verified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_badge_verified"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="1.5dp"
                        android:paddingBottom="1.5dp"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/ic_badge_check_circle"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verified"
                            android:textColor="#137333"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:layout_marginStart="2.5dp" />
                    </LinearLayout>

                    <!-- Review Pending Pill -->
                    <LinearLayout
                        android:id="@+id/badge_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_badge_pending"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="1.5dp"
                        android:paddingBottom="1.5dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/ic_badge_hourglass"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Review Pending"
                            android:textColor="#B45309"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:layout_marginStart="2.5dp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Push Chevron to the far right -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Chevron > -->
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#9CA3AF"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
