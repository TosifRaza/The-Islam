<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07221A">

    <!-- Scrollable content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/quran_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Top Banner FrameLayout -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_quran_banner"
                        android:importantForAccessibility="no" />

                    <!-- Top Bar: Back, Quran Title with gold lines, Menu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp">

                        <ImageButton
                            android:id="@+id/btn_back"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_icon_button"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="#F3DE97"
                            android:contentDescription="@string/cd_back" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_gold_quran_book_small"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="2dp">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_gold_diamond_flourish"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_marginEnd="6dp"
                                    android:text="@string/quran_title"
                                    android:textColor="#F3DE97"
                                    android:textSize="22sp"
                                    android:fontFamily="serif"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="12dp"
                                    android:scaleX="-1"
                                    android:src="@drawable/ic_gold_diamond_flourish"
                                    android:importantForAccessibility="no" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_menu"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_icon_button"
                            android:src="@drawable/ic_more_vert"
                            android:contentDescription="@string/cd_more_actions" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 2. Surah Info Card (Dark emerald with gold ornate border) -->
                <LinearLayout
                    android:id="@+id/card_surah_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="-24dp"
                    android:background="@drawable/bg_surah_info_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- Islamic 8-pointed star with Surah number -->
                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_rub_el_hizb_badge"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:id="@+id/tv_surah_number_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="1"
                            android:textColor="#F3DE97"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Surah Name & Subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_surah_name_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Al-Fatihah"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:fontFamily="serif"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_surah_sub_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="The Opening"
                            android:textColor="#B7CBC3"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btn_play_surah"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/quran_audio_play_surah_cd">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_play_mandala"
                            android:importantForAccessibility="no" />

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_play_emerald">

                            <TextView
                                android:id="@+id/tv_surah_play_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="▶"
                                android:textColor="#F3DE97"
                                android:textSize="11sp" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- Revelation place, verses count & chevron -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_surah_meta_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Makki • 7 Verses"
                            android:textColor="#B7CBC3"
                            android:textSize="12sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_chevron_down"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. Filter Tabs (Arabic, Translation, Tafsir) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tab_arabic"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_dark_tab"
                        android:gravity="center"
                        android:text="ض  Arabic"
                        android:textColor="#D1DDD7"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_translation"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.2"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_gold_active"
                        android:gravity="center"
                        android:text="📖 Translation"
                        android:textColor="#0D3B2E"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tab_tafsir"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_dark_tab"
                        android:gravity="center"
                        android:text="📚 Tafsir"
                        android:textColor="#D1DDD7"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 4. Recitation Audio Unavailable Notice -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_notice_audio"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_quran_headphones"
                        app:tint="#A3D4C4"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/audio_note"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="6dp"
                        android:text="@string/quran_audio_attribution"
                        android:textColor="#C2DCD2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ⓘ"
                        android:textColor="#F3DE97"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Loading / Error states -->
                <TextView
                    android:id="@+id/state_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="#F3DE97"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_retry"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/retry"
                    android:textColor="#F3DE97"
                    android:visibility="gone" />

                <!-- 5. Ayah Recycler View -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 6. Floating Bottom Audio Player Bar -->
    <LinearLayout
        android:id="@+id/layout_bottom_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:background="@drawable/bg_bottom_audio_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Quran Book Thumbnail -->
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_quran_green_gold_book"
            android:importantForAccessibility="no" />

        <!-- Track Info + Scrubber -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_player_surah_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Al-Fatihah"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_player_sub_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Opening"
                android:textColor="#9AB5AA"
                android:textSize="11sp" />

            <!-- Progress line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_player_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#829C91"
                    android:textSize="10sp" />

                <!-- Scrubber Bar -->
                <ProgressBar
                    android:id="@+id/player_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:indeterminate="true"
                    android:progress="0"
                    android:progressTint="#F3DE97" />

                <TextView
                    android:id="@+id/tv_player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-:--"
                    android:textColor="#829C91"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Player Controls: Previous, Play/Pause, Next -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_player_previous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/quran_audio_previous"
                android:clickable="true"
                android:focusable="true"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="6dp" />

            <!-- Circular Gold Play Button -->
            <FrameLayout
                android:id="@+id/btn_player_play"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_gold_active"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/quran_audio_resume"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">
                <TextView
                    android:id="@+id/tv_player_play_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▶"
                    android:textColor="#0D3B2E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/btn_player_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/quran_audio_next"
                android:clickable="true"
                android:focusable="true"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="6dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
