<?xml version="1.0" encoding="utf-8"?>
<!-- Shared two-line list row for M5 lists (title + optional subtitle + optional badge). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.IKP.CategoryCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_md"
    android:layout_marginVertical="@dimen/space_xxs"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <TextView
            android:id="@+id/row_badge"
            style="@style/Widget.IKP.StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/row_title"
            style="@style/TextAppearance.IKP.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs" />

        <TextView
            android:id="@+id/row_subtitle"
            style="@style/TextAppearance.IKP.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
