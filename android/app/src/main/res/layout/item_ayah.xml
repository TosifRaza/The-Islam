<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md"
    android:paddingTop="@dimen/space_sm" android:paddingBottom="@dimen/space_sm"
    android:minHeight="@dimen/touch_target_min" android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/tv_ayah_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.IKP.LabelSmall" android:textColor="@color/gold" />
    <TextView android:id="@+id/tv_ayah_arabic" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:lineSpacingExtra="6dp" android:textIsSelectable="true" android:textDirection="rtl" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.IKP.BodyMedium" />
    <TextView android:id="@+id/tv_ayah_fixture" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fixture_badge" android:textAppearance="@style/TextAppearance.IKP.LabelSmall" android:background="@drawable/bg_category_badge" android:paddingStart="@dimen/space_xs" android:paddingEnd="@dimen/space_xs" android:visibility="gone" />
    <TextView android:id="@+id/tv_ayah_translation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:textAppearance="@style/TextAppearance.IKP.BodySmall" android:textColor="@color/text_secondary" />
    <TextView android:id="@+id/tv_ayah_words" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:textAppearance="@style/TextAppearance.IKP.BodySmall" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="@dimen/space_xs">
        <ImageButton android:id="@+id/btn_bookmark" android:layout_width="@dimen/touch_target_min" android:layout_height="@dimen/touch_target_min" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_bookmark" android:src="@drawable/ic_book" />
        <ImageButton android:id="@+id/btn_copy" android:layout_width="@dimen/touch_target_min" android:layout_height="@dimen/touch_target_min" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_copy" android:src="@drawable/ic_delete" />
        <ImageButton android:id="@+id/btn_share" android:layout_width="@dimen/touch_target_min" android:layout_height="@dimen/touch_target_min" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_share" android:src="@drawable/ic_download" />
    </LinearLayout>
</LinearLayout>
