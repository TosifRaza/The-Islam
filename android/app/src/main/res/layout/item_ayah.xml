<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FAF6EE">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Subtle Mosque Silhouette Watermark in bottom right -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="-10dp"
            android:layout_marginBottom="-15dp"
            android:alpha="0.08"
            android:src="@drawable/ic_mosque_silhouette"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Top Header in Card: Star Badge Number & Mandala Play Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 8-Pointed Star Seal with Ayah Number -->
                <FrameLayout
                    android:id="@+id/layout_badge"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_rub_el_hizb_badge"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tv_ayah_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="#F3DE97"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Circular Play Button with Mandala Background -->
                <FrameLayout
                    android:id="@+id/btn_play_ayah"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/quran_audio_play_ayah_cd">

                    <!-- Arabesque mandala petals -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_play_mandala"
                        android:importantForAccessibility="no" />

                    <!-- Inner circular button -->
                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_play_emerald">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="1dp"
                            android:text="▶"
                            android:textColor="#F3DE97"
                            android:textSize="12sp" />
                    </FrameLayout>
                </FrameLayout>
            </RelativeLayout>

            <!-- Arabic Ayah Text -->
            <TextView
                android:id="@+id/tv_ayah_arabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="25sp"
                android:lineSpacingExtra="10dp"
                android:textIsSelectable="true"
                android:textDirection="rtl"
                android:textAlignment="viewStart"
                android:textColor="#0D3B2E"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <!-- Fixture Badge (if dev fixture) -->
            <TextView
                android:id="@+id/tv_ayah_fixture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fixture_badge"
                android:textAppearance="@style/TextAppearance.IKP.LabelSmall"
                android:background="@drawable/bg_category_badge"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:visibility="gone" />

            <!-- Elegant Gold Diamond Flourish Divider -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="12dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/ic_gold_diamond_flourish"
                android:importantForAccessibility="no" />

            <!-- Translation Text -->
            <TextView
                android:id="@+id/tv_ayah_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#2D3833"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Word by Word breakdown (if enabled) -->
            <TextView
                android:id="@+id/tv_ayah_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.IKP.BodySmall"
                android:visibility="gone" />

            <!-- Bottom Actions Bar: Bookmark, Copy, Delete, Download/Share -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <ImageButton
                    android:id="@+id/btn_bookmark"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_bookmark"
                    android:src="@drawable/ic_bookmark_outline" />

                <ImageButton
                    android:id="@+id/btn_copy"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_copy"
                    android:src="@drawable/ic_copy_outline" />

                <ImageButton
                    android:id="@+id/btn_delete"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete"
                    android:src="@drawable/ic_delete" />

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_share"
                    android:src="@drawable/ic_download" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
