<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="12dp">

        <!-- THE 100% EXACT MASTER CERTIFICATE (RENDERED & SHARED AS IMAGE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_formal_certificate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 100% Exact High-Resolution Master Certificate Artwork -->
                <ImageView
                    android:id="@+id/img_certificate_artwork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_formal_certificate_master"
                    android:contentDescription="Certificate of Achievement" />

                <!-- Optional Dynamic Student Name Overlay -->
                <TextView
                    android:id="@+id/tv_cert_overlay_student_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:visibility="gone"
                    android:fontFamily="serif"
                    android:textColor="#0D3B2E"
                    android:textSize="18sp"
                    android:textStyle="bold|italic" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ACTION BUTTONS: Outside the certificate card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Share Image Button -->
            <Button
                android:id="@+id/btn_share_cert"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#C9A45A"
                android:fontFamily="serif"
                android:text="Share Image"
                android:textColor="#12291F"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_share_outline"
                app:iconTint="#12291F"
                app:iconGravity="textStart" />

            <!-- Save Image Button -->
            <Button
                android:id="@+id/btn_save_cert"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#0D3B2E"
                android:fontFamily="serif"
                android:text="Save Image"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_surah_download"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_close_cert_modal"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:text="Close"
            android:textColor="#FAF7F2"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
