<?xml version="1.0" encoding="utf-8"?>
<!-- Personal deck editor: title + "front = back" card lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <TextView
        style="@style/TextAppearance.IKP.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/deck_new" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.IKP.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/deck_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_deck_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.IKP.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/deck_cards_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_deck_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
