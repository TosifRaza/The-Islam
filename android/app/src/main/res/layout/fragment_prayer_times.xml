<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btn_back" android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back" android:src="@drawable/ic_arrow_back" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/prayer_title"
            android:textAppearance="@style/TextAppearance.IKP.TitleMedium" />
    </LinearLayout>
    <Spinner android:id="@+id/spinner_city" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_margin="@dimen/space_md"
        android:contentDescription="@string/prayer_city" />
    <Button android:id="@+id/btn_use_city" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/prayer_use_city" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md">
        <EditText android:id="@+id/input_lat" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="@string/prayer_lat" android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" />
        <EditText android:id="@+id/input_lon" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="@string/prayer_lon" android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" />
    </LinearLayout>
    <Button android:id="@+id/btn_use_manual" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/prayer_use_manual" />
    <Button android:id="@+id/btn_use_device" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/prayer_use_device" />
    <TextView android:id="@+id/tv_permission_note" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="@dimen/space_md"
        android:textAppearance="@style/TextAppearance.IKP.LabelSmall"
        android:textColor="@color/text_secondary" android:visibility="gone" />
    <Spinner android:id="@+id/spinner_method" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_margin="@dimen/space_md"
        android:contentDescription="@string/prayer_method" />
    <TextView android:id="@+id/tv_times" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="@dimen/space_md"
        android:textAppearance="@style/TextAppearance.IKP.BodyMedium" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/space_md" android:text="@string/prayer_notifications_note"
        android:textAppearance="@style/TextAppearance.IKP.LabelSmall"
        android:textColor="@color/text_secondary" />
</LinearLayout>
