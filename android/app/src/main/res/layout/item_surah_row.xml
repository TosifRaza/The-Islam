<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FDFBF7">

    <LinearLayout
        android:id="@+id/layout_surah_row"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:foreground="?attr/selectableItemBackground"
        android:background="@drawable/bg_surah_card">

        <!-- 8-Pointed Star Badge with Surah Number -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_rub_el_hizb_badge"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="1" />
        </FrameLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="1dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#E8DFC9" />

        <!-- Arabic Name (LTR container to keep exact layout order) -->
        <TextView
            android:id="@+id/tv_name_ar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="ltr"
            android:textColor="#0C2F24"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="الفَاتِحَة" />

        <!-- Decorative Gold Sparkle -->
        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_gold_sparkle"
            android:contentDescription="@null" />

        <!-- English Name & Verses Count -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0C2F24"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Al-Fatihah" />

            <TextView
                android:id="@+id/tv_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6E8076"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:text="7 Verses" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="#E8DFC9" />

        <!-- Favourite Heart Icon Button -->
        <ImageButton
            android:id="@+id/btn_favourite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_heart_outline"
            app:tint="#4A6658"
            android:contentDescription="Favourite" />

        <!-- Divider Line -->
        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#E8DFC9" />

        <!-- Download Icon Button -->
        <ImageButton
            android:id="@+id/btn_download"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_surah_download"
            app:tint="#4A6658"
            android:contentDescription="Download" />

    </LinearLayout>
</androidx.cardview.widget.CardView>