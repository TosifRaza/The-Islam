<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <ImageButton
        android:id="@+id/btn_back"
        style="@style/TouchBack"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="@string/cd_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_xl">

        <TextView
            android:id="@+id/unavailable_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.IKP.HeadlineMedium" />

        <TextView
            android:id="@+id/unavailable_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.IKP.BodyLarge"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btn_back_login"
            style="@style/Widget.IKP.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_sign_in" />
    </LinearLayout>
</LinearLayout>
